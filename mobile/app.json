{
  "expo": {
    "name": "Black Mamba",
    "slug": "black-mamba-fantasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blackmamba.fantasy"
    },
    "android": {
      "package": "com.blackmamba.fantasy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.blackmamba",
          "enableGooglePay": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffcc44"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#ffcc44",
      "androidMode": "default"
    },
    "extra": {
      "eas": {
        "projectId": "e784f0b9-88d8-4e40-8ce8-dd52df01b286"
      }
    }
  }
}
